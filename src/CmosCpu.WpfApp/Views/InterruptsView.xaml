<UserControl x:Class="CmosCpu.WpfApp.Views.InterruptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CmosCpu.WpfApp.Converters">
    <UserControl.Resources>
        <c:FlagToBrushConverter x:Key="FlagBrush" />
    </UserControl.Resources>
    <Border Background="#2D2D2D" BorderBrush="#3E3E3E" BorderThickness="1" Padding="6">
        <StackPanel>
            <TextBlock Text="Interrupts &amp; Vectors" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,6" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="I.Disable:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InterruptDisable}" Foreground="#DCDCAA" FontSize="11" Margin="2" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="IRQ Pending:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IrqPending}" Foreground="#DCDCAA" FontSize="11" Margin="2" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="NMI Pending:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NmiPending}" Foreground="#DCDCAA" FontSize="11" Margin="2" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="RESET Vec:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ResetVector}" Foreground="#DCDCAA" FontSize="11" Margin="2" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="IRQ Vec:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IrqVector}" Foreground="#DCDCAA" FontSize="11" Margin="2" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="NMI Vec:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding NmiVector}" Foreground="#DCDCAA" FontSize="11" Margin="2" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Last:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastInterrupt}" Foreground="#CE9178" FontSize="11" Margin="2" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
