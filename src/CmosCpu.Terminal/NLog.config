<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">

  <targets>
    <target name="file" xsi:type="File"
            fileName="logs/simulator-terminal.log"
            layout="${longdate} | ${level:uppercase=true} | ${message}"
            archiveEvery="Day" archiveNumbering="Rolling" maxArchiveFiles="7"
            archiveAboveSize="10485760" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="file" />
    <logger name="*" minlevel="Trace" writeTo="file" final="false">
      <filters>
        <when condition="equals('${var:verbose}','true')" action="log" />
        <when condition="equals('${var:verbose}','false')" action="ignore" />
      </filters>
    </logger>
  </rules>
</nlog>
