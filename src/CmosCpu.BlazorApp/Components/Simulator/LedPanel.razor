<div class="panel">
    <div class="panel-title">LED</div>
    <div class="led-container">
        <div class="led-indicator @(State.LedOn ? "led-on" : "led-off")"></div>
        <span class="mono @(State.LedOn ? "status-ok" : "")" style="font-weight:bold; font-size:14px;">
            @(State.LedOn ? "ON" : "OFF")
        </span>
    </div>
    <div style="color: var(--text-dim); font-size:11px;">Address: 0xC000</div>
</div>

@code {
    [Parameter] public UiSimulatorState State { get; set; } = null!;
}
