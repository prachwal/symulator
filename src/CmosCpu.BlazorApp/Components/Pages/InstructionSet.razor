@page "/instruction-set"
@using CmosCpu.Core

<h3>Instruction Set</h3>

<div class="sim-table-container">
    <table class="sim-table">
        <thead>
            <tr>
                <th>Opcode</th>
                <th>Mnemonic</th>
                <th>Operand</th>
                <th>Bytes</th>
                <th>Cycles</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var instr in InstructionInfo.All)
            {
                <tr>
                    <td><code>@($"0x{(byte)instr.Key:X2}")</code></td>
                    <td><strong>@instr.Value.Mnemonic</strong></td>
                    <td>@instr.Value.OperandFormat</td>
                    <td>@instr.Value.ByteCount</td>
                    <td>@instr.Value.CycleCount</td>
                    <td>@instr.Value.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>
