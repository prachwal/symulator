<Application x:Class="CmosCpu.WpfApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CmosCpu.WpfApp.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <c:BoolToOnOffConverter x:Key="BoolToOnOff" />
            <c:ByteToHexConverter x:Key="ByteToHex" />
            <c:UShortToHexConverter x:Key="UShortToHex" />
            <c:FlagToBrushConverter x:Key="FlagBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
