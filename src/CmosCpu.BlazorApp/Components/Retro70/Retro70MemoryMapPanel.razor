@using CmosCpu.Core
@using CmosCpu.Computer
@inject Retro70Service Retro70

<div class="panel" style="margin-bottom: 8px;">
    <div class="panel-title">Memory Map</div>
    @if (Retro70.Profile is not null)
    {
        <div class="sim-table-container">
            <table class="sim-table" style="font-size: 11px;">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Size</th>
                        <th>Name</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Retro70.Profile.Memory?.Ram is not null)
                    {
                        foreach (var ram in Retro70.Profile.Memory.Ram)
                        {
                            var start = ComputerProfileLoader.ParseHex(ram.Start!);
                            var size = ComputerProfileLoader.ParseHex(ram.Size!);
                            var end = start + size - 1;
                            <tr>
                                <td style="color: var(--green);">RAM</td>
                                <td class="mono">@start.ToString("X4")</td>
                                <td class="mono">@end.ToString("X4")</td>
                                <td class="mono">@FormatSize(size)</td>
                                <td>Main RAM</td>
                            </tr>
                        }
                    }
                    @if (Retro70.Profile.Memory?.Rom is not null)
                    {
                        foreach (var rom in Retro70.Profile.Memory.Rom)
                        {
                            var start = ComputerProfileLoader.ParseHex(rom.Start!);
                            var size = ComputerProfileLoader.ParseHex(rom.Size!);
                            var end = start + size - 1;
                            <tr>
                                <td style="color: var(--yellow);">ROM</td>
                                <td class="mono">@start.ToString("X4")</td>
                                <td class="mono">@end.ToString("X4")</td>
                                <td class="mono">@FormatSize(size)</td>
                                <td>Monitor ROM</td>
                            </tr>
                        }
                    }
                    @if (Retro70.Profile.Devices is not null)
                    {
                        foreach (var dev in Retro70.Profile.Devices)
                        {
                            string displayType = dev.Type switch
                            {
                                "text-display" => "SCREEN",
                                "keyboard" => "KBD",
                                _ => dev.Type?.ToUpper() ?? "DEV"
                            };
                            string addr = dev.Type == "keyboard"
                                ? dev.DataAddress ?? ""
                                : dev.Start ?? "";
                            string color = dev.Type == "text-display" ? "var(--text-accent)" : "var(--text-mnemonic)";
                            string name = dev.Type == "text-display"
                                ? $"Text Display {dev.Width}x{dev.Height}"
                                : "Keyboard";
                            <tr>
                                <td style="color: @color;">@displayType</td>
                                @if (!string.IsNullOrEmpty(addr))
                                {
                                    var start = ComputerProfileLoader.ParseHex(addr);
                                    int size = dev.Type == "text-display" ? dev.Width * dev.Height : 2;
                                    var end = start + size - 1;
                                    <td class="mono">@start.ToString("X4")</td>
                                    <td class="mono">@end.ToString("X4")</td>
                                    <td class="mono">@($"{size} B")</td>
                                }
                                else
                                {
                                    <td colspan="3" style="color: var(--text-dim);">—</td>
                                }
                                <td>@name</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding: 8px; color: var(--text-dim); font-size: 12px;">
            Load a profile to see the memory map
        </div>
    }
</div>

@code {
    private static string FormatSize(ushort bytes) => bytes switch
    {
        >= 1024 when bytes % 1024 == 0 => $"{bytes / 1024} KB",
        >= 1024 => $"{bytes / 1024}.{bytes % 1024 * 10 / 1024} KB",
        _ => $"{bytes} B"
    };
}
