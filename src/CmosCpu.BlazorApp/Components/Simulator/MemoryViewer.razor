@using CmosCpu.BlazorApp.Models
@using CmosCpu.BlazorApp.Services
@inject IBlazorSimulationController SimController

<div class="panel">
    <div class="panel-title">Memory Viewer</div>
    <div class="memory-controls">
        <button class="btn-small" @onclick="GoToPC">Go to PC</button>
        <button class="btn-small" @onclick="Refresh">Refresh</button>
    </div>
    <div class="table-wrap" style="max-height:200px;">
        <table class="hex-table hex-table-memory">
            <thead>
                <tr>
                    <th>Address</th>
                    <th>+0</th><th>+1</th><th>+2</th><th>+3</th><th>+4</th><th>+5</th><th>+6</th><th>+7</th>
                    <th>+8</th><th>+9</th><th>+A</th><th>+B</th><th>+C</th><th>+D</th><th>+E</th><th>+F</th>
                    <th>ASCII</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in State.MemoryRows)
                {
                    <tr>
                        <td class="mem-addr mono">@row.AddressText</td>
                        @for (int c = 0; c < 16; c++)
                        {
                            <td class="mono @(row.IsPc[c] ? "mem-cell-pc" : "mem-cell")">@row.Cells[c]</td>
                        }
                        <td class="mem-ascii mono">@row.AsciiText</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter] public UiSimulatorState State { get; set; } = null!;

    private void GoToPC()
    {
        var snap = SimController.GetSnapshot();
        if (snap is not null)
            State.UpdateFromSnapshot(snap);
    }

    private void Refresh()
    {
        var snap = SimController.GetSnapshot();
        if (snap is not null)
            State.UpdateFromSnapshot(snap);
    }
}
