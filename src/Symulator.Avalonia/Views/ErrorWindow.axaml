<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Symulator.Avalonia.Views.ErrorWindow"
        Title="Errors"
        Width="600"
        Height="400"
        MinWidth="400"
        MinHeight="300">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="4">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock FontWeight="Bold" VerticalAlignment="Center">Errors:</TextBlock>
                <TextBlock Text="{Binding ErrorCount}" VerticalAlignment="Center" />
                <Button Content="Clear" Command="{Binding ClearCommand}" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ErrorEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Timestamp}" FontSize="11" />
                                    <TextBlock Text="{Binding Severity}" FontWeight="Bold" Foreground="Red" />
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="Gray"
                                           TextWrapping="Wrap" MaxHeight="80" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
