@using CmosCpu.BlazorApp.Models

<div class="panel">
    <div class="panel-title">CPU Registers</div>
    <div class="regs-grid">
        <span class="reg-label">A</span><span class="reg-value mono">@Hex8(State.A)</span>
        <span class="reg-label">X</span><span class="reg-value mono">@Hex8(State.X)</span>
        <span class="reg-label">Y</span><span class="reg-value mono">@Hex8(State.Y)</span>
        <span class="reg-label">PC</span><span class="reg-value mono">@Hex16(State.PC)</span>
        <span class="reg-label">SP</span><span class="reg-value mono">@Hex16(State.SP)</span>
        <span class="reg-label">Cycles</span><span class="reg-value mono">@State.Cycles</span>
        <span class="reg-label">Instr</span><span class="reg-value mono reg-instr">@State.CurrentInstruction</span>
        <span class="reg-label">State</span>
        <span class="reg-value mono @(State.Halted ? "status-error" : "status-ok")">
            @(State.Halted ? "HALTED" : "Running")
        </span>
    </div>
</div>

@code {
    [Parameter] public UiSimulatorState State { get; set; } = null!;

    private static string Hex8(byte value) => $"0x{value:X2}";
    private static string Hex16(ushort value) => $"0x{value:X4}";
}
