    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="NLog" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Symulator.Application\Symulator.Application.csproj" />
    <ProjectReference Include="..\Symulator.Machines.Apple1\Symulator.Machines.Apple1.csproj" />
    <ProjectReference Include="..\Symulator.Machines.Kim1\Symulator.Machines.Kim1.csproj" />
