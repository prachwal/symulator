@using CmosCpu.Computer
@inject Retro70Service Retro70

<div class="panel" style="margin-bottom: 8px;">
    <div class="panel-title">CPU State</div>
    @if (Retro70.Cpu is not null)
    {
        var cpu = Retro70.Cpu;
        <div class="cpu-regs-grid">
            <div class="cpu-reg-label">A</div>
            <div class="cpu-reg-value">@cpu.A.ToString("X2")</div>
            <div class="cpu-reg-label">X</div>
            <div class="cpu-reg-value">@cpu.X.ToString("X2")</div>
            <div class="cpu-reg-label">Y</div>
            <div class="cpu-reg-value">@cpu.Y.ToString("X2")</div>
            <div class="cpu-reg-label">PC</div>
            <div class="cpu-reg-value">@cpu.PC.ToString("X4")</div>
            <div class="cpu-reg-label">SP</div>
            <div class="cpu-reg-value">@cpu.SP.ToString("X2")</div>
            <div class="cpu-reg-label">Cycles</div>
            <div class="cpu-reg-value">@cpu.CycleCount</div>
        </div>
        <div style="margin-top: 6px;">
            <div class="cpu-reg-label" style="margin-bottom: 2px;">Flags</div>
            <div class="flags-row">
                <span class="flag @(cpu.Negative ? "flag-on" : "flag-off")">N</span>
                <span class="flag @(cpu.Overflow ? "flag-on" : "flag-off")">V</span>
                <span class="flag @(cpu.Break ? "flag-on" : "flag-off")">B</span>
                <span class="flag @(cpu.Decimal ? "flag-on" : "flag-off")">D</span>
                <span class="flag @(cpu.InterruptDisable ? "flag-on" : "flag-off")">I</span>
                <span class="flag @(cpu.Zero ? "flag-on" : "flag-off")">Z</span>
                <span class="flag @(cpu.Carry ? "flag-on" : "flag-off")">C</span>
            </div>
        </div>
    }
    else
    {
        <div style="padding: 8px; color: var(--text-dim); font-size: 12px;">
            Load a profile to see CPU state
        </div>
    }
</div>
