<UserControl x:Class="CmosCpu.WpfApp.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CmosCpu.WpfApp.Converters">
    <UserControl.Resources>
        <c:ByteToHexConverter x:Key="ByteToHex" />
        <c:FlagToBrushConverter x:Key="FlagBrush" />
    </UserControl.Resources>
    <Border Background="#2D2D2D" BorderBrush="#3E3E3E" BorderThickness="1" Padding="6">
        <StackPanel>
            <TextBlock Text="I/O Devices" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,6" />

            <TextBlock Text="Timer (0xC010-0xC012)" FontWeight="SemiBold" Foreground="#CE9178" FontSize="11" Margin="0,0,0,2" />
            <Grid Margin="4,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Counter:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TimerCounter}" Style="{StaticResource HexValue}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Control:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TimerControl, Converter={StaticResource ByteToHex}}" Style="{StaticResource HexValue}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TimerStatus, Converter={StaticResource ByteToHex}}" Style="{StaticResource HexValue}" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Running:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TimerRunning}" Style="{StaticResource HexValue}" />
            </Grid>

            <TextBlock Text="RTC (0xC020-0xC025)" FontWeight="SemiBold" Foreground="#CE9178" FontSize="11" Margin="0,4,0,2" />
            <Grid Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Second:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RtcSecond}" Style="{StaticResource HexValue}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Minute:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding RtcMinute}" Style="{StaticResource HexValue}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Hour:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RtcHour}" Style="{StaticResource HexValue}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Day:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding RtcDay}" Style="{StaticResource HexValue}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Month:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RtcMonth}" Style="{StaticResource HexValue}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Year:" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding RtcYear}" Style="{StaticResource HexValue}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
