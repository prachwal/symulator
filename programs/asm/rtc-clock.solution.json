{
  "id": "rtc-clock",
  "name": "RTC Clock on LCD",
  "source": "rtc-clock.asm",
  "entryPoint": "0x0100",
  "loadAddress": "0x0100",
  "cpu": {
    "type": "minimal-blink-cpu",
    "clockHz": 1000000
  },
  "memory": {
    "ram": [
      { "start": "0x0000", "size": "0x0100" }
    ]
  },
  "devices": [
    { "id": "cpu", "type": "cpu", "name": "CPU", "visible": true },
    { "id": "rtc0", "type": "rtc-mmio", "name": "RTC DS3231", "baseAddress": "0xD100", "visible": true,
      "options": { "timeMode": "host" } },
    { "id": "lcd0", "type": "hd44780-mmio", "name": "LCD 16x2", "baseAddress": "0xFE00", "visible": true,
      "options": { "timing": "ideal" } }
  ],
  "ui": {
    "layout": {
      "left": ["program-loader"],
      "center": ["lcd0"],
      "right": ["cpu", "rtc0"],
      "bottom": ["asm-tabs"]
    }
  }
}
