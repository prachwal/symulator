{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build all",
            "command": "dotnet",
            "type": "process",
            "args": ["build"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test all",
            "command": "dotnet",
            "type": "process",
            "args": ["test"],
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build WPF GUI",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "src/CmosCpu.WpfApp/CmosCpu.WpfApp.csproj",
                "-p:EnableWindowsTargeting=true"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "detail": "Build WPF GUI (requires Windows SDK or EnableWindowsTargeting on Linux)"
        },
        {
            "label": "run WPF GUI",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "src/CmosCpu.WpfApp/CmosCpu.WpfApp.csproj"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "Run WPF GUI (Windows only — requires Microsoft.WindowsDesktop.App)",
            "dependsOn": ["build WPF GUI"]
        },
        {
            "label": "build ConsoleApp",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "src/CmosCpu.ConsoleApp/CmosCpu.ConsoleApp.csproj"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run ConsoleApp (blink, 10000 cycles)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "src/CmosCpu.ConsoleApp/CmosCpu.ConsoleApp.csproj",
                "--",
                "--cycles",
                "10000"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "dependsOn": ["build ConsoleApp"]
        },
        {
            "label": "run ConsoleApp (with trace)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "src/CmosCpu.ConsoleApp/CmosCpu.ConsoleApp.csproj",
                "--",
                "--program",
                "examples/blink.asm",
                "--cycles",
                "5000",
                "--trace"
            ],
            "group": "test",
            "problemMatcher": "$msCompile",
            "dependsOn": ["build ConsoleApp"]
        },
        {
            "label": "test WPF ViewModels",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "tests/CmosCpu.WpfApp.Tests/CmosCpu.WpfApp.Tests.csproj"
            ],
            "group": "test",
            "problemMatcher": "$msCompile",
            "detail": "Run WPF ViewModel/service tests (Windows only)"
        },
        {
            "label": "build BlazorApp",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "src/CmosCpu.BlazorApp/CmosCpu.BlazorApp.csproj"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run BlazorApp",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "src/CmosCpu.BlazorApp/CmosCpu.BlazorApp.csproj"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "Run Blazor web app — open https://localhost:5001/simulator",
            "dependsOn": ["build BlazorApp"]
        },
        {
            "label": "test BlazorApp",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "tests/CmosCpu.BlazorApp.Tests/CmosCpu.BlazorApp.Tests.csproj"
            ],
            "group": "test",
            "problemMatcher": "$msCompile",
            "detail": "Run Blazor service/model unit tests"
        },
        {
            "label": "clean",
            "command": "dotnet",
            "type": "process",
            "args": ["clean"],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
