@page "/debugger"
@using CmosCpu.BlazorApp.Services
@using CmosCpu.Core
@inject IDebugger BpService
@implements IDisposable

<div class="simulator-page">
    <div class="panel">
        <div class="panel-title">Debugger — Breakpoints</div>

        <div class="simulator-toolbar" style="margin-bottom: 8px;">
            <input class="tb-input" type="text" @bind="_addressText"
                   placeholder="0x8000" style="width: 140px;" />
            <button class="btn" @onclick="AddBreakpoint">Add Breakpoint</button>
            <button class="btn" @onclick="ClearBreakpoints">Clear All</button>
        </div>

        @if (_errorMessage is not null)
        {
            <div style="color: var(--color-error); margin-bottom: 8px;">@_errorMessage</div>
        }

        <div class="sim-table-container">
            <table class="sim-table">
                <thead>
                    <tr>
                        <th>Address</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (BpService.Breakpoints.Count == 0)
                    {
                        <tr><td colspan="2" style="color: var(--text-dim);">No breakpoints set.</td></tr>
                    }
                    @foreach (var bp in BpService.Breakpoints.OrderBy(a => a))
                    {
                        <tr>
                            <td class="mono">@($"0x{bp:X4}")</td>
                            <td><button class="btn-small" @onclick="() => RemoveBreakpoint(bp)">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string _addressText = string.Empty;
    private string? _errorMessage;

    private void AddBreakpoint()
    {
        _errorMessage = null;

        if (AddressParser.TryParseAddress(_addressText, out var addr))
        {
            BpService.AddBreakpoint(addr);
            _addressText = string.Empty;
        }
        else
        {
            _errorMessage = $"Invalid address: '{_addressText}'. Use hex (e.g. 0x8000, $8000, 8000).";
        }
    }

    private void RemoveBreakpoint(ushort addr)
    {
        BpService.RemoveBreakpoint(addr);
    }

    private void ClearBreakpoints()
    {
        BpService.ClearBreakpoints();
    }

    public void Dispose() { }
}
