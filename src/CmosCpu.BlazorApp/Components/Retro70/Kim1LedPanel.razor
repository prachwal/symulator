@using CmosCpu.Computer
@inject Retro70Service Retro70

@if (Retro70.Kim1LedDisplay is not null)
{
    var display = Retro70.Kim1LedDisplay;
    <div class="panel" style="margin-bottom: 8px;">
        <div class="panel-title">KIM-1 LED Display</div>
        <div style="display: flex; gap: 4px; padding: 8px; justify-content: center; font-family: var(--font-mono);">
            @foreach (char ch in display.Digits)
            {
                <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 36px; background: #1a1a2e; border: 1px solid #4a4a6a; border-radius: 3px; color: #ff4444; font-size: 18px; font-weight: bold; box-shadow: inset 0 0 6px rgba(255,0,0,0.3);">@ch</span>
            }
        </div>
    </div>
}
