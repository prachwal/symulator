<UserControl x:Class="CmosCpu.WpfApp.Views.TraceLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#2D2D2D" BorderBrush="#3E3E3E" BorderThickness="1" Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Trace Log" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,4" />

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Cycle}" Foreground="#808080" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding PC}" Foreground="#569CD6" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Opcode}" Foreground="#DCDCAA" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Mnemonic}" Foreground="#CE9178" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Operands}" Foreground="#808080" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding A}" Foreground="#DCDCAA" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{Binding X}" Foreground="#DCDCAA" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="7" Text="{Binding Y}" Foreground="#DCDCAA" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="8" Text="{Binding SP}" Foreground="#DCDCAA" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="9" Text="{Binding Flags}" Foreground="#808080" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="10" Text="{Binding Description}" Foreground="#808080" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
