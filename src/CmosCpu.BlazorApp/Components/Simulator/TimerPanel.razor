@using CmosCpu.BlazorApp.Models

<div style="margin-bottom:8px;">
    <div style="color:var(--text-mnemonic); font-size:11px; font-weight:600; margin-bottom:4px;">Timer (0xC010-0xC012)</div>
    <div class="regs-grid">
        <span class="reg-label">Counter</span><span class="reg-value mono">@State.TimerCounter</span>
        <span class="reg-label">Control</span><span class="reg-value mono">@State.TimerControl</span>
        <span class="reg-label">Status</span><span class="reg-value mono">@State.TimerStatus</span>
        <span class="reg-label">Running</span><span class="reg-value mono">@State.TimerRunning</span>
    </div>
</div>

@code {
    [Parameter] public UiSimulatorState State { get; set; } = null!;
}
