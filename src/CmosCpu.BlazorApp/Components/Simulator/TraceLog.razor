@using CmosCpu.BlazorApp.Models

<div class="table-wrap">
    <table class="hex-table">
        <thead>
            <tr>
                <th>Cycle</th>
                <th>PC</th>
                <th>Opcode</th>
                <th>Mnemonic</th>
                <th>A</th>
                <th>X</th>
                <th>Y</th>
                <th>SP</th>
                <th>Flags</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Entries)
            {
                <tr>
                    <td class="mono">@entry.Cycle</td>
                    <td class="mono">@entry.PC</td>
                    <td class="mono">@entry.Opcode</td>
                    <td><strong>@entry.Mnemonic</strong></td>
                    <td class="mono">@entry.A</td>
                    <td class="mono">@entry.X</td>
                    <td class="mono">@entry.Y</td>
                    <td class="mono">@entry.SP</td>
                    <td class="mono">@entry.Flags</td>
                    <td>@entry.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<TraceEntryViewModel> Entries { get; set; } = new();
    [Parameter] public EventCallback OnClear { get; set; }
}
