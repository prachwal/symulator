<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Symulator.Machines.Kim1.Views"
             x:Class="Symulator.Machines.Kim1.Views.Kim1LedDisplayView">
    <Border BorderBrush="#31404F" BorderThickness="1" Padding="8" Background="#1a1a1a">
        <StackPanel>
            <TextBlock Text="6-Digit LED Display" FontWeight="Bold" Foreground="#4DFF88" FontSize="13" />
            <local:SevenSegmentDisplay
                Digits="{Binding DisplayText}"
                Width="260"
                Height="56"
                Margin="0,4,0,0"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
