@using CmosCpu.BlazorApp.Services
@inject IProgramUploadService UploadService

<div class="sim-toolbar">
    <div class="sim-toolbar-buttons">
        <label class="sim-btn" role="button">
            Load ASM
            <InputFile OnChange="@(async e => await LoadAsm(e))" accept=".asm" hidden />
        </label>
        <label class="sim-btn" role="button">
            Load BIN
            <InputFile OnChange="@(async e => await LoadBin(e))" accept=".bin" hidden />
        </label>

        <span class="sim-toolbar-sep"></span>

        <button class="sim-btn" @onclick="OnReset">Reset</button>
        <button class="sim-btn" @onclick="HandleStep">Step</button>
        <button class="sim-btn sim-btn-run" @onclick="HandleRun" disabled="@(Controller.IsRunning)">Run</button>
        <button class="sim-btn" @onclick="OnPause" disabled="@(!Controller.IsRunning)">Pause</button>
        <button class="sim-btn" @onclick="OnStop">Stop</button>

        <span class="sim-toolbar-sep"></span>

        <span class="sim-toolbar-label">Speed:</span>
        <select class="sim-toolbar-select" @bind="SpeedText">
            <option value="1">1 Hz</option>
            <option value="10">10 Hz</option>
            <option value="100" selected>100 Hz</option>
            <option value="1000">1 kHz</option>
            <option value="0">Max</option>
        </select>
    </div>
</div>

@code {
    [Parameter] public IBlazorSimulationController Controller { get; set; } = null!;
    [Parameter] public EventCallback OnStep { get; set; }
    [Parameter] public EventCallback OnRun { get; set; }

    private string SpeedText
    {
        get => Controller.SpeedHz.ToString();
        set
        {
            if (int.TryParse(value, out int hz))
                Controller.SpeedHz = hz;
        }
    }

    private async Task LoadAsm(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (!UploadService.ValidateFile(file.Name, file.Size, out var error))
        {
            Controller.ReportStatus(error ?? "Invalid file");
            return;
        }

        await using var stream = file.OpenReadStream(maxAllowedSize: 1 * 1024 * 1024);
        await Controller.LoadAsmAsync(stream, file.Name, CancellationToken.None);
    }

    private async Task LoadBin(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (!UploadService.ValidateFile(file.Name, file.Size, out var error))
        {
            Controller.ReportStatus(error ?? "Invalid file");
            return;
        }

        await using var stream = file.OpenReadStream(maxAllowedSize: 1 * 1024 * 1024);
        await Controller.LoadBinAsync(stream, file.Name, 0x8000, CancellationToken.None);
    }

    private void OnReset()
    {
        Controller.Reset();
    }

    private void HandleStep()
    {
        Controller.Step();
        OnStep.InvokeAsync();
    }

    private async Task HandleRun()
    {
        await Controller.RunAsync(CancellationToken.None);
        await OnRun.InvokeAsync();
    }

    private void OnPause()
    {
        Controller.Pause();
    }

    private void OnStop()
    {
        Controller.Stop();
    }
}
