@using CmosCpu.BlazorApp.Models

<div class="sim-panel-header">CPU Registers</div>
<div class="sim-panel-body">
    <div class="sim-reg-grid">
        <span class="sim-reg-label">A:</span>
        <span class="sim-reg-value">0x@State.A.ToString("X2")</span>
        <span class="sim-reg-label">X:</span>
        <span class="sim-reg-value">0x@State.X.ToString("X2")</span>

        <span class="sim-reg-label">Y:</span>
        <span class="sim-reg-value">0x@State.Y.ToString("X2")</span>
        <span class="sim-reg-label">PC:</span>
        <span class="sim-reg-value">0x@State.PC.ToString("X4")</span>

        <span class="sim-reg-label">SP:</span>
        <span class="sim-reg-value">0x@State.SP.ToString("X4")</span>
        <span class="sim-reg-label">Cycles:</span>
        <span class="sim-reg-value">@State.Cycles</span>

        <span class="sim-reg-label">Instr:</span>
        <span class="sim-reg-value sim-reg-instr">@State.CurrentInstruction</span>
        <span class="sim-reg-label">State:</span>
        <span class="sim-reg-value sim-reg-state @(State.Halted ? "sim-state-halted" : "sim-state-running")">
            @(State.Halted ? "HALTED" : "Running")
        </span>
    </div>
</div>

@code {
    [Parameter] public UiSimulatorState State { get; set; } = null!;
}
