@using CmosCpu.BlazorApp.Models

<div class="panel">
    <div class="panel-title">Interrupts</div>
    <div class="regs-grid">
        <span class="reg-label">I.Disable</span><span class="reg-value mono">@State.InterruptDisable</span>
        <span class="reg-label">IRQ Pending</span><span class="reg-value mono">@State.IrqPending</span>
        <span class="reg-label">NMI Pending</span><span class="reg-value mono">@State.NmiPending</span>
        <span class="reg-label">RESET Vec</span><span class="reg-value mono">@State.ResetVector</span>
        <span class="reg-label">IRQ Vec</span><span class="reg-value mono">@State.IrqVector</span>
        <span class="reg-label">NMI Vec</span><span class="reg-value mono">@State.NmiVector</span>
    </div>
</div>

@code {
    [Parameter] public UiSimulatorState State { get; set; } = null!;
}
