<UserControl x:Class="CmosCpu.WpfApp.Views.FlagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#2D2D2D" BorderBrush="#3E3E3E" BorderThickness="1" Padding="6">
        <StackPanel>
            <TextBlock Text="Flags" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,6" />
            <CheckBox IsChecked="{Binding Zero}" IsEnabled="False" Content="Zero" Foreground="#D4D4D4" Margin="2">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Opacity" Value="0.4" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#4EC9B0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
            <CheckBox IsChecked="{Binding Carry}" IsEnabled="False" Content="Carry" Foreground="#D4D4D4" Margin="2">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Opacity" Value="0.4" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#4EC9B0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
            <CheckBox IsChecked="{Binding Negative}" IsEnabled="False" Content="Negative" Foreground="#D4D4D4" Margin="2">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Opacity" Value="0.4" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#F44747" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
            <CheckBox IsChecked="{Binding InterruptDisable}" IsEnabled="False" Content="I.Disable" Foreground="#D4D4D4" Margin="2">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Opacity" Value="0.4" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#CE9178" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
            <TextBlock Text="{Binding FlagsText}" Foreground="#808080" FontSize="10" Margin="2,4,2,0" />
        </StackPanel>
    </Border>
</UserControl>
