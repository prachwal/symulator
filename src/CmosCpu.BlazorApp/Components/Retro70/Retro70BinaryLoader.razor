@using CmosCpu.Computer
@inject Retro70Service Retro70

<div class="panel" style="margin-bottom: 8px;">
    <div class="panel-title">Load Binary Program</div>
    @if (Retro70.IsLoaded)
    {
        <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap; padding: 4px 0;">
            <span class="tb-label" style="font-size: 11px;">Address:</span>
            <input type="text" @bind="_addressText" placeholder="0x8000"
                   style="width: 80px; background: var(--bg-root); color: var(--text); border: 1px solid var(--border); padding: 4px 8px; font-family: var(--font-mono); font-size: 12px;" />
            <label class="btn" role="button" style="font-size: 12px;">
                Choose .bin file
                <InputFile OnChange="@OnFileSelected" accept=".bin" hidden />
            </label>
            <button class="btn" @onclick="LoadBinary" disabled="@(_binaryData is null)" style="font-size: 12px;">Load Binary</button>
            @if (!string.IsNullOrEmpty(_status))
            {
                <span class="mono" style="font-size: 11px; @(_status.Contains("Loaded") ? "color: var(--green);" : "color: var(--red);")">@_status</span>
            }
        </div>
    }
    else
    {
        <div style="padding: 8px; color: var(--text-dim); font-size: 12px;">
            Load a profile first
        </div>
    }
</div>

@code {
    private string _addressText = "0x8000";
    private byte[]? _binaryData;
    private string _fileName = "";
    private string _status = "";

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _fileName = file.Name;
        _status = "";

        using var stream = file.OpenReadStream(maxAllowedSize: 64 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _binaryData = ms.ToArray();

        _status = $"Loaded {_binaryData.Length} bytes from '{_fileName}'";
    }

    private void LoadBinary()
    {
        if (_binaryData is null || _binaryData.Length == 0) return;

        ushort address;
        try
        {
            address = ComputerProfileLoader.ParseHex(_addressText);
        }
        catch
        {
            _status = $"Invalid address: '{_addressText}'";
            return;
        }

        bool success = Retro70.LoadBinary(_binaryData, address, setResetVector: true);
        _status = success
            ? $"Loaded {_binaryData.Length} bytes at 0x{address:X4}, reset vector updated"
            : "Failed to load";
    }
}
