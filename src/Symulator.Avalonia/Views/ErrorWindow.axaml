<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Symulator.Avalonia.Views.ErrorWindow"
        Title="Errors"
        Width="760"
        Height="460"
        MinWidth="500"
        MinHeight="320"
        Background="#101418"
        Foreground="#D8E1EA">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8" Background="#182028" BorderBrush="#31404F" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0">Errors:</TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding ErrorCount}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding LogsPath}" Foreground="#8A99A8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="Clear" Command="{Binding ClearCommand}" />
            </Grid>
        </Border>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ErrorEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#31404F" BorderThickness="0,0,0,1" Padding="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="#8A99A8" />
                                    <TextBlock Text="{Binding Severity}" FontWeight="Bold" Foreground="#FF5C5C" />
                                </StackPanel>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#8A99A8" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
