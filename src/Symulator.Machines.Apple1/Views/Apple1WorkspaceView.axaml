<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Symulator.Machines.Apple1.Views.Apple1WorkspaceView">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
            <Button Content="Boot MON" />
            <Button Content="Boot BASIC" />
            <Button Content="Reset" />
            <Button Content="Clear" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,4,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Send" Margin="4,0,0,0" />
                <TextBox Text="{Binding InputText}" AcceptsReturn="False" Watermark="Enter command..." />
            </DockPanel>
            <TextBlock Text="{Binding StatusText}" FontStyle="Italic" />
        </StackPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock FontWeight="Bold" Text="Terminal - Mode: " />
                <TextBlock Text="{Binding ModeText}" />
            </StackPanel>
            <Border BorderBrush="Gray" BorderThickness="1" MinHeight="200">
                <ScrollViewer>
                    <TextBlock Text="{Binding TerminalOutput, Mode=OneWay}"
                               FontFamily="Courier New"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</UserControl>
