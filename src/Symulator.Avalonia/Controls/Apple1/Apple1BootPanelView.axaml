<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Symulator.Avalonia.Controls.Apple1.Apple1BootPanelView">
    <StackPanel Spacing="4">
        <TextBlock FontWeight="Bold">Boot Options</TextBlock>
        <Button Content="Boot Woz Monitor" />
        <Button Content="Boot BASIC" />
        <TextBlock Text="{Binding Status}" FontStyle="Italic" />
    </StackPanel>
</UserControl>
