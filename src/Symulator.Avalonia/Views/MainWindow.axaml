<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Symulator.Avalonia.Views.MainWindow"
        Title="Symulator"
        Width="1024"
        Height="768"
        MinWidth="800"
        MinHeight="600">
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Exit" Click="OnExitClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Padding="4" Background="DimGray">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Grid ColumnDefinitions="200,*,250">
            <Border Grid.Column="0" Margin="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4">Machines</TextBlock>
                    <ListBox ItemsSource="{Binding Machines}"
                             SelectedItem="{Binding SelectedMachine}"
                             Name="MachineList" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Margin="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4">Emulator</TextBlock>
                    <ScrollViewer>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="Start" Command="{Binding StartCommand}" />
                                <Button Content="Pause" Command="{Binding PauseCommand}" />
                                <Button Content="Reset" Command="{Binding ResetCommand}" />
                                <Button Content="Step" Command="{Binding StepCommand}" />
                            </StackPanel>

                            <TextBlock Text="Terminal Output" FontWeight="Bold" />
                            <Border BorderBrush="Gray" BorderThickness="1" MinHeight="200">
                                <ScrollViewer Name="TerminalScroll">
                                    <TextBlock Text="{Binding TerminalText}"
                                               FontFamily="Courier New"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Margin="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4">CPU State</TextBlock>
                    <ScrollViewer>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding CpuStateText}" FontFamily="Courier New" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
