@using CmosCpu.BlazorApp.Models

<div class="table-wrap">
    <table class="hex-table">
        <thead>
            <tr>
                <th>Cycle</th>
                <th>Op</th>
                <th>Address</th>
                <th>Value</th>
                <th>Device</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tx in Entries)
            {
                <tr>
                    <td class="mono">@tx.Cycle</td>
                    <td class="mono @(tx.Operation == "READ" ? "status-ok" : "status-error")">@tx.Operation</td>
                    <td class="mono">@tx.Address</td>
                    <td class="mono">@tx.Value</td>
                    <td class="mono">@tx.Device</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<BusTransactionViewModel> Entries { get; set; } = new();
    [Parameter] public EventCallback OnClear { get; set; }
}
