<UserControl x:Class="CmosCpu.WpfApp.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CmosCpu.WpfApp.Converters">
    <UserControl.Resources>
        <c:ByteToHexConverter x:Key="ByteToHex" />
        <c:UShortToHexConverter x:Key="UShortToHex" />
    </UserControl.Resources>
    <Border Background="#2D2D2D" BorderBrush="#3E3E3E" BorderThickness="1" Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Memory Viewer" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,4" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Address:" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding AddressInput, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,4,0" />
                <Button Content="Go to PC" Command="{Binding GoToPCCommand}" Margin="2" Padding="6,1" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="2" Padding="6,1" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="18" Background="{Binding RowBackground}" />

                                <TextBlock Grid.Column="0" Text="{Binding AddressText}" Foreground="#569CD6" FontSize="11" VerticalAlignment="Center" Margin="1,0" />

                                <TextBlock Grid.Column="1" Text="{Binding Cell0Hex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="2" Text="{Binding Cell1Hex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="3" Text="{Binding Cell2Hex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="4" Text="{Binding Cell3Hex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="5" Text="{Binding Cell4Hex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="6" Text="{Binding Cell5Hex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="7" Text="{Binding Cell6Hex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="8" Text="{Binding Cell7Hex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="9" Text="{Binding Cell8Hex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="10" Text="{Binding Cell9Hex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="11" Text="{Binding CellAHex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="12" Text="{Binding CellBHex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="13" Text="{Binding CellCHex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="14" Text="{Binding CellDHex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="15" Text="{Binding CellEHex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />
                                <TextBlock Grid.Column="16" Text="{Binding CellFHex}" FontSize="11" VerticalAlignment="Center" Margin="1,0" Foreground="#DCDCAA" />

                                <TextBlock Grid.Column="17" Text="{Binding AsciiText}" FontSize="11" VerticalAlignment="Center" Margin="2,0" Foreground="#808080" FontFamily="Consolas" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
