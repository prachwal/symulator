<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20" Width="400" Height="300" />
    </Design.PreviewWith>

    <Style Selector="Window">
        <Setter Property="Background" Value="#101418" />
        <Setter Property="Foreground" Value="#D8E1EA" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="#182028" />
        <Setter Property="BorderBrush" Value="#31404F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style Selector="Border.terminal">
        <Setter Property="Background" Value="#050607" />
        <Setter Property="BorderBrush" Value="#31404F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="TextBlock.monospace">
        <Setter Property="FontFamily" Value="Courier New" />
    </Style>

    <Style Selector="TextBlock.status">
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="#8A99A8" />
    </Style>

    <Style Selector="TextBlock.led">
        <Setter Property="Foreground" Value="#4DFF88" />
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LetterSpacing" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="#202A34" />
        <Setter Property="Foreground" Value="#D8E1EA" />
        <Setter Property="BorderBrush" Value="#31404F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="#31404F" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="#4EA1FF" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="#4EA1FF" />
        <Setter Property="Foreground" Value="#101418" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#FF5C5C" />
        <Setter Property="Foreground" Value="#101418" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="#101418" />
        <Setter Property="Foreground" Value="#D8E1EA" />
        <Setter Property="BorderBrush" Value="#31404F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="#101418" />
        <Setter Property="Foreground" Value="#D8E1EA" />
        <Setter Property="BorderBrush" Value="#31404F" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="#4EA1FF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="#202A34" />
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="#101418" />
    </Style>

    <Style Selector="Menu">
        <Setter Property="Background" Value="#182028" />
        <Setter Property="Foreground" Value="#D8E1EA" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#D8E1EA" />
    </Style>

    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="#202A34" />
    </Style>
</Styles>
