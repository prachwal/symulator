@using CmosCpu.BlazorApp.Models

<div class="panel">
    <div class="panel-title">Flags</div>
    <div class="flags-grid">
        <span class="flag-badge @(State.Zero ? "flag-on flag-green" : "flag-off")">
            Zero: @(State.Zero ? "ON" : "OFF")
        </span>
        <span class="flag-badge @(State.Carry ? "flag-on flag-green" : "flag-off")">
            Carry: @(State.Carry ? "ON" : "OFF")
        </span>
        <span class="flag-badge @(State.Negative ? "flag-on flag-red" : "flag-off")">
            Negative: @(State.Negative ? "ON" : "OFF")
        </span>
        <span class="flag-badge @(State.InterruptDisable ? "flag-on flag-yellow" : "flag-off")">
            I.Disable: @(State.InterruptDisable ? "ON" : "OFF")
        </span>
    </div>
    <div class="mono" style="color: var(--text-dim); font-size: 10px; margin-top: 4px;">@State.FlagsText</div>
</div>

@code {
    [Parameter] public UiSimulatorState State { get; set; } = null!;
}
