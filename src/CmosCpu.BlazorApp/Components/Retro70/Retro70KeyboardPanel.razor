@using CmosCpu.Computer
@inject Retro70Service Retro70

<div class="panel" style="margin-bottom: 8px;">
    <div class="panel-title">Keyboard</div>
    @if (Retro70.Keyboard is not null)
    {
        <div style="display: flex; gap: 6px; align-items: center; padding: 4px 0;">
            <input type="text" @bind="_keyInput" @onkeydown="HandleKeyDown"
                   placeholder="Type here..."
                   style="flex: 1; background: var(--bg-root); color: var(--text); border: 1px solid var(--border); padding: 4px 8px; font-family: var(--font-mono);" />
            <span class="mono" style="font-size: 11px; color: var(--text-dim);">Keys pending: @Retro70.Keyboard.PendingCount</span>
        </div>
    }
    else
    {
        <div style="padding: 8px; color: var(--text-dim); font-size: 12px;">
            Load a profile to use the keyboard
        </div>
    }
</div>

@code {
    private string _keyInput = "";

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (!string.IsNullOrEmpty(e.Key) && e.Key.Length == 1)
        {
            Retro70.EnqueueKey(e.Key[0]);
            _keyInput = "";
        }
        else if (e.Key == "Enter")
        {
            Retro70.EnqueueKey('\r');
            _keyInput = "";
        }
    }
}
