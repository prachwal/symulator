<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Symulator.Avalonia.Controls.Kim1.Kim1ControlPanelView">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4">KIM-1 Control Panel</TextBlock>
        <StackPanel Spacing="8">
            <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Background="#1a1a1a">
                <StackPanel>
                    <TextBlock Text="6-Digit LED Display" FontWeight="Bold" Foreground="LimeGreen" />
                    <TextBlock Text="{Binding DisplayText}"
                               FontFamily="Courier New"
                               FontSize="28"
                               Foreground="LimeGreen"
                               LetterSpacing="4"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
