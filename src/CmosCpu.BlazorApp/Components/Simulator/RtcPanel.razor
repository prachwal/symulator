@using CmosCpu.BlazorApp.Models

<div>
    <div style="color:var(--text-mnemonic); font-size:11px; font-weight:600; margin-bottom:4px;">RTC (0xC020-0xC025)</div>
    <div class="regs-grid">
        <span class="reg-label">Second</span><span class="reg-value mono">@State.RtcSecond</span>
        <span class="reg-label">Minute</span><span class="reg-value mono">@State.RtcMinute</span>
        <span class="reg-label">Hour</span><span class="reg-value mono">@State.RtcHour</span>
        <span class="reg-label">Day</span><span class="reg-value mono">@State.RtcDay</span>
        <span class="reg-label">Month</span><span class="reg-value mono">@State.RtcMonth</span>
        <span class="reg-label">Year</span><span class="reg-value mono">@State.RtcYear</span>
    </div>
</div>

@code {
    [Parameter] public UiSimulatorState State { get; set; } = null!;
}
