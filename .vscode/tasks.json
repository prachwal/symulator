{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build all",
            "command": "dotnet",
            "type": "process",
            "args": ["build"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run Avalonia",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "src/Symulator.Avalonia/Symulator.Avalonia.csproj"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "Run Avalonia desktop GUI (Apple-1 / KIM-1)",
            "dependsOn": ["build all"]
        },
        {
            "label": "test Application",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "tests/Symulator.Application.Tests",
                "--no-build"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test Apple-1",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "tests/Symulator.Machines.Apple1.Tests",
                "--no-build"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test KIM-1",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "tests/Symulator.Machines.Kim1.Tests",
                "--no-build"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test CPU (non-reference)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "tests/CmosCpu.Cpu.Tests",
                "--no-build",
                "--filter",
                "FullyQualifiedName!~Reference"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test Computer (safe)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "tests/CmosCpu.Computer.Tests",
                "--no-build",
                "--filter",
                "FullyQualifiedName!~RunController"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "clean",
            "command": "dotnet",
            "type": "process",
            "args": ["clean"],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
