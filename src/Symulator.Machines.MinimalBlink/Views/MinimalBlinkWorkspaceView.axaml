<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Symulator.Machines.MinimalBlink.Views"
             x:Class="Symulator.Machines.MinimalBlink.Views.MinimalBlinkWorkspaceView">

  <Grid RowDefinitions="Auto,*,Auto"
        Background="#0B0F14"
        Margin="8">

    <!-- Header -->
    <Border Grid.Row="0"
            BorderBrush="#31404F"
            BorderThickness="1"
            Background="#111820"
            Padding="8"
            Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Minimal Blink Computer"
                     FontWeight="Bold"
                     FontSize="16"
                     Foreground="#E6EDF3" />
          <TextBlock Text="{Binding StatusText}"
                     FontStyle="Italic"
                     Foreground="#9DA7B3" />
          <TextBlock Text="{Binding LastError}"
                     TextWrapping="Wrap"
                     Foreground="#FF5C5C"
                     FontSize="11" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Text="{Binding ProgramStatus}"
                   VerticalAlignment="Center"
                   Foreground="#7CFF7C"
                   FontSize="12"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          ColumnDefinitions="320,*,340"
          MinHeight="270">

      <!-- Program lifecycle -->
      <Border Grid.Column="0"
              BorderBrush="#31404F"
              BorderThickness="1"
              Background="#111820"
              Padding="10"
              Margin="0,0,8,0">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="ASM Program"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#E6EDF3" />
            <TextBlock Text="Select → Compile → Load &amp; Reset → Step/Run"
                       Foreground="#9DA7B3"
                       FontSize="11" />
            <TextBlock Text="{Binding ProgramStatus}"
                       Foreground="#7CFF7C"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedSolutionSummary}"
                       Foreground="#9DA7B3"
                       FontSize="11"
                       TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="ASM source file"
                       FontWeight="Bold"
                       Foreground="#B0BCC8" />
            <ComboBox ItemsSource="{Binding AsmPrograms}"
                      SelectedItem="{Binding SelectedAsmProgram}"
                      MinWidth="250">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Compile"
                      Command="{Binding CompileCommand}"
                      MinWidth="90" />
              <Button Content="Load &amp; Reset"
                      Command="{Binding LoadAndResetCommand}"
                      MinWidth="120" />
            </StackPanel>

            <TextBlock Text="Compile does not change memory. Load &amp; Reset loads the compiled image and sets PC."
                       Foreground="#9DA7B3"
                       FontSize="11"
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- UART terminal is visible only when the selected solution declares an UART module. -->
      <Border Grid.Column="1"
              IsVisible="{Binding ShowUartModule}"
              BorderBrush="#31404F"
              BorderThickness="1"
              Background="#0D1117"
              Padding="10"
              Margin="0,0,8,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="UART Terminal"
                     FontWeight="Bold"
                     FontSize="15"
                     Foreground="#7CFF7C"
                     Margin="0,0,0,6" />

          <TextBox DockPanel.Dock="Bottom"
                   Text="{Binding TerminalInputText, Mode=TwoWay}"
                   Watermark="Type and press Enter"
                   KeyDown="OnTerminalKeyDown"
                   FontFamily="Consolas"
                   Foreground="#7CFF7C"
                   Background="#0D1117"
                   BorderBrush="#31404F"
                   Margin="0,6,0,0" />

          <ScrollViewer Background="#0D1117">
            <ItemsControl ItemsSource="{Binding TerminalLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Foreground="#B0BCC8"
                             TextWrapping="NoWrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              IsVisible="{Binding ShowI2cModule}"
              BorderBrush="#31404F"
              BorderThickness="1"
              Background="#111820"
              Padding="10"
              Margin="0,0,8,0">
        <StackPanel Spacing="6">
          <TextBlock Text="I2C Controller"
                     FontWeight="Bold"
                     FontSize="15"
                     Foreground="#B0BCC8" />
          <TextBlock Text="MMIO: $FE30-$FE33"
                     FontFamily="Consolas"
                     Foreground="#E6EDF3" />
          <TextBlock Text="Device module is declared by solution JSON. Runtime builder will be implemented in the next hardware-builder phase."
                     Foreground="#9DA7B3"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1"
              IsVisible="{Binding ShowNoCenterModule}"
              BorderBrush="#31404F"
              BorderThickness="1"
              Background="#0D1117"
              Padding="10"
              Margin="0,0,8,0">
        <StackPanel Spacing="6">
          <TextBlock Text="No center module"
                     FontWeight="Bold"
                     FontSize="15"
                     Foreground="#9DA7B3" />
          <TextBlock Text="The selected solution does not declare UART or another center panel."
                     Foreground="#9DA7B3"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Hardware stack: visible modules are controlled by selected .solution.json. -->
      <StackPanel Grid.Column="2" Spacing="8">

        <Border Width="340"
                Height="118"
                IsVisible="{Binding ShowLcdModule}"
                BorderBrush="#31404F"
                BorderThickness="1"
                Background="#111820"
                Padding="10">
          <StackPanel Spacing="6">
            <TextBlock Text="LCD 16x2"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#B0BCC8" />
            <Border BorderBrush="#263241"
                    BorderThickness="1"
                    Padding="6"
                    Background="#182028"
                    HorizontalAlignment="Stretch">
              <views:MinimalBlinkLcdControl Pixels="{Binding LcdPixels}" />
            </Border>
          </StackPanel>
        </Border>

        <Border Width="340"
                Height="118"
                IsVisible="{Binding ShowCpuModule}"
                BorderBrush="#31404F"
                BorderThickness="1"
                Background="#111820"
                Padding="10">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="CPU"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#E6EDF3"
                       Margin="0,0,0,6" />
            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*,Auto,*"
                  RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="PC" Margin="0,0,8,3" Foreground="#9DA7B3" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Pc}" FontFamily="Consolas" Foreground="#E6EDF3" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="A" Margin="14,0,8,3" Foreground="#9DA7B3" />
              <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding A}" FontFamily="Consolas" Foreground="#E6EDF3" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Z" Margin="0,0,8,3" Foreground="#9DA7B3" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Z}" Foreground="#E6EDF3" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="HLT" Margin="14,0,8,3" Foreground="#9DA7B3" />
              <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Halted}" Foreground="#E6EDF3" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="CY" Margin="0,0,8,0" Foreground="#9DA7B3" />
              <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Cycles}" FontFamily="Consolas" Foreground="#E6EDF3" />
            </Grid>
          </Grid>
        </Border>

        <Border Width="340"
                Height="118"
                IsVisible="{Binding ShowLedModule}"
                BorderBrush="#31404F"
                BorderThickness="1"
                Background="#111820"
                Padding="10">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="LED"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="#4DFF88"
                       Margin="0,0,0,6" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
              <Ellipse Grid.Column="0"
                       Width="28"
                       Height="28"
                       Fill="{Binding LedColor}"
                       Stroke="#4DFF88"
                       StrokeThickness="1"
                       VerticalAlignment="Top"
                       Margin="0,3,12,0" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding LedOn, StringFormat='State: {0}'}" Foreground="#E6EDF3" />
                <TextBlock Text="{Binding LedToggleCount, StringFormat='Toggles: {0}'}" Foreground="#E6EDF3" />
                <TextBlock Text="{Binding LedLastValue, StringFormat='Last value: 0x{0:X2}'}" Foreground="#E6EDF3" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2"
            BorderBrush="#31404F"
            BorderThickness="1"
            Background="#0D1117"
            Padding="6"
            Margin="0,8,0,0"
            VerticalAlignment="Bottom">
      <TabControl Height="250">
        <TabItem Header="ASM Source">
          <TextBox Text="{Binding AsmSourceText, Mode=TwoWay}"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="#B0BCC8"
                   Background="#0D1117"
                   BorderBrush="#263241"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap" />
        </TabItem>

        <TabItem Header="Compiled Listing">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ExecutableListingLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#1F2933"
                          BorderThickness="0,0,0,1"
                          Padding="2">
                    <Grid ColumnDefinitions="24,80,140,*">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding CurrentLineMarker}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Foreground="#FFCC66" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Address, StringFormat='${0:X4}'}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Foreground="#569CD6" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding BytesText}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Foreground="#DCDCAA" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding InstructionText}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Foreground="#B0BCC8"
                                 TextWrapping="NoWrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
</UserControl>
