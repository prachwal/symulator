<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Symulator.Avalonia.Controls.Kim1.Kim1LedDisplayView">
    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Background="#1a1a1a">
        <StackPanel>
            <TextBlock Text="LED Display" FontWeight="Bold" Foreground="LimeGreen" />
            <TextBlock Text="{Binding DisplayText}"
                       FontFamily="Courier New"
                       FontSize="24"
                       Foreground="LimeGreen"
                       LetterSpacing="4"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
