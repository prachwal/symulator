@page "/retro70"
@using CmosCpu.Computer
@using CmosCpu.Core
@inject Retro70Service Retro70
@inject ComputerRunController RunControl
@implements IDisposable

<div class="simulator-page">

    <!-- Status bar -->
    <div class="status-bar" style="background: #4a2d70;">
        <span class="status-text">@(Retro70.Profile?.Name ?? "Retro70 MOS 6502")</span>
        <span class="status-sep">|</span>
        <span class="mono">CPU: MOS 6502</span>
        <span class="status-sep">|</span>
        <span class="mono">@(Retro70.Profile?.ClockHz > 0 ? $"{Retro70.Profile.ClockHz / 1000000} MHz" : "")</span>
        <span class="status-sep">|</span>
        <span class="mono @(Retro70.Cpu is not null && Retro70.Cpu.IsHalted ? "status-error" : "status-ok")">
            @StatusMessage
        </span>
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <span class="status-sep">|</span>
            <span class="mono status-error">@_errorMessage</span>
        }
        @if (!string.IsNullOrEmpty(RunControl.LastError))
        {
            <span class="status-sep">|</span>
            <span class="mono status-error">@RunControl.LastError</span>
        }
    </div>

    <!-- Toolbar -->
    <div class="simulator-toolbar">
        <button class="btn btn-primary" @onclick="LoadDefaultProfile">Load Profile</button>
        <button class="btn" @onclick="Reset" disabled="@(!Retro70.IsLoaded || RunControl.IsRunning)">Reset</button>
        <span class="tb-sep"></span>
        <button class="btn" @onclick="Step" disabled="@(!Retro70.IsLoaded || RunControl.IsRunning)">Step</button>
        <button class="btn btn-run" @onclick="RunAsync" disabled="@(!Retro70.IsLoaded || RunControl.IsRunning)">Run</button>
        <button class="btn" @onclick="Pause" disabled="@(!RunControl.IsRunning)">Pause</button>
        <span class="tb-sep"></span>
        <button class="btn" @onclick="ClearScreen" disabled="@(!Retro70.IsLoaded)">Clear screen</button>
    </div>

    <!-- Speed settings -->
    @if (Retro70.IsLoaded)
    {
        <div style="display: flex; gap: 8px; align-items: center; padding: 4px 0; font-size: 12px;">
            <span class="mono" style="color: var(--text-dim);">Speed:</span>
            <button class="btn" @onclick="() => SetSpeed(10, 100)" style="font-size: 11px; @(RunControl.InstructionsPerBatch == 10 ? "border-color: var(--text-accent);" : "")">Slow</button>
            <button class="btn" @onclick="() => SetSpeed(1000, 16)" style="font-size: 11px; @(RunControl.InstructionsPerBatch == 1000 ? "border-color: var(--text-accent);" : "")">Normal</button>
            <button class="btn" @onclick="() => SetSpeed(10000, 16)" style="font-size: 11px; @(RunControl.InstructionsPerBatch == 10000 ? "border-color: var(--text-accent);" : "")">Fast</button>
            <span class="tb-sep"></span>
            <span class="mono" style="color: var(--text-dim);">Batch: @RunControl.InstructionsPerBatch</span>
            <span class="mono" style="color: var(--text-dim);">Delay: @RunControl.RenderDelayMs ms</span>
        </div>
    }

    <!-- Main layout -->
    <div style="display: flex; gap: 8px;">

        <!-- Left: screens + keyboard -->
        <div style="flex: 1; min-width: 0;">
            <Apple1TerminalPanel />
            <Kim1LedPanel />
            <Retro70TextScreenPanel />
            <Kim1KeypadPanel />
            <Retro70KeyboardPanel />
            <Retro70BinaryLoader />
        </div>

        <!-- Right: CPU state + memory map + diagnostics -->
        <div style="width: 460px; flex-shrink: 0;">
            <Retro70CpuStatePanel />
            <Retro70MemoryMapPanel />
            @if (Retro70.IsLoaded)
            {
                <DiagnosticPanel />
                <MemoryViewPanel />
            }
        </div>

    </div>

</div>

@code {
    private bool _firstLoad = true;
    private string _errorMessage = "";

    private string StatusMessage
    {
        get
        {
            if (RunControl.IsRunning) return "Running...";
            if (Retro70.Cpu?.IsHalted == true) return "HALTED";
            if (!Retro70.IsLoaded) return "No profile loaded";
            return "Stopped";
        }
    }

    protected override void OnInitialized()
    {
        Retro70.StateChanged += OnStateChanged;
        RunControl.StateChanged += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _firstLoad)
        {
            _firstLoad = false;
            try
            {
                LoadDefaultProfile();
            }
            catch (Exception ex)
            {
                _errorMessage = $"Auto-load failed: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private void LoadDefaultProfile()
    {
        _errorMessage = "";
        if (!Retro70.LoadDefaultProfile())
        {
            _errorMessage = "Failed to load default profile";
            StateHasChanged();
            return;
        }
        Retro70.LoadMonitorRom();
        Retro70.Reset();
        RunControl.SetMachine(Retro70.Machine);
        StateHasChanged();
    }

    private void Reset()
    {
        RunControl.Stop();
        Retro70.Reset();
        RunControl.SetMachine(Retro70.Machine);
    }

    private void Step()
    {
        Retro70.Step();
    }

    private async Task RunAsync()
    {
        if (RunControl.IsRunning) return;
        await RunControl.StartAsync();
    }

    private void Pause()
    {
        RunControl.Stop();
    }

    private void ClearScreen()
    {
        Retro70.ClearScreen();
    }

    private void SetSpeed(int batch, int delayMs)
    {
        RunControl.InstructionsPerBatch = batch;
        RunControl.RenderDelayMs = delayMs;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Retro70.StateChanged -= OnStateChanged;
        RunControl.StateChanged -= OnStateChanged;
        RunControl.Dispose();
    }
}
